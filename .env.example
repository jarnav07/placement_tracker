# Browser (safe to expose — these are public, RLS-protected credentials)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Automation only. NEVER prefix these with VITE_ and never commit real values.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# PRIMARY verification provider. Get a key at https://aistudio.google.com/apikey
# and add it to the repository as the Actions secret GEMINI_API_KEY.
GEMINI_API_KEY=your-gemini-api-key
# Optional. Leave unset and the verifier picks the strongest model your key can
# reach from the API's own model list, so a model deprecation does not break the
# nightly run. Set it to pin one, e.g. gemini-2.5-pro.
GEMINI_MODEL=

# SECONDARY verification provider, asked for a second opinion whenever a decision
# is consequential, contested or low-confidence. Two providers must agree before
# a role is marked Closed.
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=your-azure-key
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4.1-mini
