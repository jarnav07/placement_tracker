# Browser (safe to expose — these are public, RLS-protected credentials)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Automation only. NEVER prefix these with VITE_ and never commit real values.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# PRIMARY verification provider — set ONE of the two keys below.
# Same Gemini models either way; only the endpoint and the key differ.
# `npm run check:providers` tells you in seconds whether yours works.
# ---------------------------------------------------------------------------

# Option A — Vertex AI. Requires an EXPRESS MODE key: express mode is what lets
# Vertex accept an API key at all. A plain Google Cloud API key is refused with
# "API keys are not supported by this API" even when the Vertex AI API is
# enabled on the project. Express mode takes no project id and no location.
VERTEX_API_KEY=your-vertex-express-mode-api-key

# Option B — Gemini Developer API. Key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Force a backend when both keys are present: vertex | aistudio
GEMINI_BACKEND=
# Optional. Pin the model, e.g. gemini-2.5-pro. Unset, the verifier reads the
# backend's model list and otherwise falls back through known models in order.
GEMINI_MODEL=

# ---------------------------------------------------------------------------
# SECONDARY verification provider, asked for a second opinion whenever a
# decision is consequential, contested or low-confidence. Two providers must
# agree before a role is marked Closed.
# ---------------------------------------------------------------------------
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=your-azure-key
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4.1-mini
